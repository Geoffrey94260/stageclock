{
  "name": "stageclock",
  "version": "1.0.0",
  "description": "Professional stage timer for live events",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npx --no-install vite",
    "build": "npx --no-install vite build && npx --no-install electron-builder",
    "build:win": "npx --no-install vite build && npx --no-install electron-builder --win",
    "build:mac": "npx --no-install vite build && npx --no-install electron-builder --mac",
    "preview": "npx --no-install vite preview",
    "rebuild": "npx --no-install electron-rebuild -f -w osc,ws"
  },
  "keywords": [
    "timer",
    "stage",
    "ndi",
    "companion",
    "electron"
  ],
  "author": "Stageclock",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.0.0",
    "vite": "^5.1.0",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "^4.0.0",
    "osc": "^2.4.3",
    "ws": "^8.16.0",
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.stageclock.app",
    "productName": "Stageclock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "public/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/osc/**/*",
      "node_modules/ws/**/*",
      "node_modules/granddio/**/*"
    ]
  }
}